# Copy to .env and fill in credentials (never commit .env)

SPACE_TRACK_USERNAME=your@email.com
SPACE_TRACK_PASSWORD=your_space_track_password
DISCOS_TOKEN=your_discos_api_token

# Data source mode: SYNTHETIC (offline generator) or ACTUAL (live APIs + MMT)
DATA_MODE=SYNTHETIC

# Legacy alias — ignored when DATA_MODE is set
USE_SYNTHETIC=true

# MMT photometry source: mmt9 (default in ACTUAL), offline, or api
# mmt9 = http://mmt.favor2.info (public DB linked from http://mmt9.ru/satellites/)
# MMT_SOURCE=mmt9
# MMT9_BASE_URL=http://mmt.favor2.info

# Optional placeholder REST API (only when MMT_SOURCE=api)
# MMT_API_URL=https://mmt.insap.org/api/lightcurve

# ACTUAL ingest driver: mmt (default) picks objects from mmt9_candidates.csv when present,
# else MMT-9 catalog sample; then queries Space-Track + DISCOS by NORAD
# FETCH_DRIVER=mmt
# MMT9_CANDIDATES_CSV=data/raw/mmt9_candidates.csv
# MMT9_CANDIDATES_LIMIT=0   # 0 = all rows in CSV; set e.g. 10 to test a subset

# MMT9_FORCE_REFRESH=true   # re-download even when cache exists

# Catalog fallback only (ignored when mmt9_candidates.csv exists)
FETCH_MAX_OBJECTS=50
FETCH_EPOCH_DAYS=60

# KeepTrack API — NORAD ↔ COSPAR resolution (https://api.keeptrack.space/v4/docs)
# KEEPTRACK_API_KEY=your_keeptrack_api_key
