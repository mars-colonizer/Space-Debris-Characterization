# Copy to .env and fill in credentials (never commit .env)

SPACE_TRACK_USERNAME=your@email.com
SPACE_TRACK_PASSWORD=your_space_track_password
DISCOS_TOKEN=your_discos_api_token

# Data source mode: SYNTHETIC (offline generator) or ACTUAL (live APIs + MMT)
DATA_MODE=SYNTHETIC

# Legacy alias — ignored when DATA_MODE is set
USE_SYNTHETIC=true

# Optional MMT-9 / Mini-MegaTORTORA API (falls back to data/raw/mmt_lightcurves/)
# MMT_API_URL=https://mmt.insap.org/api/lightcurve

# Optional fetch limits for ACTUAL mode
FETCH_MAX_OBJECTS=200
FETCH_EPOCH_DAYS=60
